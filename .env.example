# Database connection string (PostgreSQL / Neon)
# For local Postgres: postgresql://postgres:postgres@localhost:5432/expense_manager
# For Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_manager"

# Better Auth secret key (can be generated with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Better Auth URL (public URL of the app)
BETTER_AUTH_URL="http://localhost:3100"

# Optional: Disable rate limiting for auth endpoints (set to 'off' for E2E tests)
# AUTH_RATE_LIMIT="off"

# Web push for daily reminders. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Secret for the reminder job. Call GET /api/cron/reminders every 15-60 minutes
# with the header "Authorization: Bearer <CRON_SECRET>" (e.g. Vercel Cron or cron + curl).
CRON_SECRET=""

# Public address of the site (for canonical links, the sitemap and social previews).
# Falls back to BETTER_AUTH_URL. Example: https://hisab.app
SITE_URL=""
