# Database connection string (PostgreSQL / Neon)
# For local Postgres: postgresql://postgres:postgres@localhost:5432/expense_manager
# For Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_manager"

# Better Auth secret key (can be generated with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Better Auth URL (public URL of the app)
BETTER_AUTH_URL="http://localhost:3100"

# Optional: Disable rate limiting for auth endpoints (set to 'off' for E2E tests)
# AUTH_RATE_LIMIT="off"
